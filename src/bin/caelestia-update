#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"

set -uo pipefail

die()  { echo "[FATAL] $*" >&2; exit 1; }
info() { echo "[INFO]  $*"; }
ok()   { echo "[OK]    $*"; }
warn() { echo "[WARN]  $*"; }

# Fingerprint of the maintainer's release-signing key, or empty to fall back to
# GitHub's shared web-flow key.
#
# This is deliberately a constant in the *installed* updater rather than a value
# read from the checkout: an anchor taken from the repository being verified is
# worth nothing, because whoever controls that repository controls the anchor.
# Set it here (or via CAELESTIA_RELEASE_SIGNER) once a release key exists, and
# commit the public key to .github/release-signing-key.asc so the material can
# be found. Only the fingerprint has to be trusted; the key file is checked
# against it.
#
# Empty means: fall back to web-flow, which proves a commit was created through
# github.com but does NOT identify who created it. See .github/docs/update_trust.md.
CAELESTIA_RELEASE_SIGNER="${CAELESTIA_RELEASE_SIGNER:-}"
WEB_FLOW_FINGERPRINT="968479A1AFF927E37D1A566BB5690EEEBB952194"

verify_checkout() {
    [[ "${CAELESTIA_ALLOW_UNVERIFIED_UPDATE:-0}" == "1" ]] && {
        warn "Skipping Git signature verification by explicit request."
        return
    }

    local repo="$UPD_DIR/repo"
    local anchor anchor_kind key_path
    local verify_home fingerprints status valid_fingerprint

    verify_home="$(mktemp -d "${TMPDIR:-/tmp}/caelestia-verify.XXXXXX")" || die "Could not create verification directory"
    chmod 700 "$verify_home"

    if [[ -n "$CAELESTIA_RELEASE_SIGNER" ]]; then
        [[ "$CAELESTIA_RELEASE_SIGNER" =~ ^[0-9A-Fa-f]{40}$ ]] || {
            rm -rf -- "$verify_home"
            die "CAELESTIA_RELEASE_SIGNER must be a full 40-character fingerprint"
        }
        anchor="$(printf '%s' "$CAELESTIA_RELEASE_SIGNER" | tr '[:lower:]' '[:upper:]')"
        anchor_kind="maintainer release-signing key"
        key_path="$repo/.github/release-signing-key.asc"
        [[ -f "$key_path" ]] || {
            rm -rf -- "$verify_home"
            die "Release signer is pinned but .github/release-signing-key.asc is missing from the update"
        }
    else
        anchor="$WEB_FLOW_FINGERPRINT"
        anchor_kind="GitHub web-flow key"
        key_path="$verify_home/trusted.asc"
        curl -fsSL --proto '=https' --tlsv1.2 https://github.com/web-flow.gpg -o "$key_path" || {
            rm -rf -- "$verify_home"
            die "Could not download trusted public key"
        }
    fi

    fingerprints="$(gpg --homedir "$verify_home" --batch --with-colons --import-options show-only --import "$key_path" 2>/dev/null | awk -F: '$1 == "fpr" { print $10 }')"
    grep -Fxq "$anchor" <<< "$fingerprints" || {
        rm -rf -- "$verify_home"
        die "Trusted signer fingerprint mismatch ($anchor_kind)"
    }
    gpg --homedir "$verify_home" --batch --import "$key_path" >/dev/null 2>&1 || {
        rm -rf -- "$verify_home"
        die "Could not import trusted public key"
    }

    # Prefer an annotated signed tag over the commit it points at.
    status=""
    if [[ "${TARGET_KIND:-}" == "tag" && -n "${TARGET_REF:-}" ]] \
        && [[ "$(git -C "$repo" cat-file -t "$TARGET_REF" 2>/dev/null)" == "tag" ]]; then
        status="$(GNUPGHOME="$verify_home" git -C "$repo" -c gpg.program=gpg verify-tag --raw "$TARGET_REF" 2>&1 || true)"
    fi
    if ! grep -q 'VALIDSIG' <<< "$status"; then
        status="$(GNUPGHOME="$verify_home" git -C "$repo" -c gpg.program=gpg verify-commit --raw HEAD 2>&1 || true)"
    fi

    valid_fingerprint="$(printf '%s\n' "$status" | sed -n 's/^\[GNUPG:\] VALIDSIG \([0-9A-F]*\) .*/\1/p' | head -n1)"
    rm -rf -- "$verify_home"
    [[ "$valid_fingerprint" == "$anchor" ]] || \
        die "Refusing untrusted update ($anchor_kind). Set CAELESTIA_ALLOW_UNVERIFIED_UPDATE=1 only for a trusted local test."
    info "Update signature verified against the $anchor_kind."
}

run_stage() {
    local timeout_seconds="$1"
    shift

    if command -v timeout >/dev/null 2>&1; then
        timeout --foreground "$timeout_seconds" "$@"
    else
        "$@"
    fi
}

# Canonical repository. Keep the default in sync with REPO in
# .github/version.env; check_repo_identity.py gates that in CI.
CAELESTIA_REPO="${CAELESTIA_REPO:-Vinax89/caelestia-dots-kde}"
CAELESTIA_REPO_URL="https://github.com/${CAELESTIA_REPO}.git"

BRANCH="${1:-main}"
TARGET_REF="${2:-}"
if [ "$BRANCH" != "main" ] && [ "$BRANCH" != "dev" ]; then
    echo "Warning: Branch '$BRANCH' is not allowed. Falling back to 'main'."
    BRANCH="main"
fi
if ! git ls-remote --exit-code --heads "$CAELESTIA_REPO_URL" "$BRANCH" >/dev/null 2>&1; then
    echo "Warning: Branch '$BRANCH' does not exist on remote. Falling back to 'main'."
    BRANCH="main"
fi

if [ -n "$TARGET_REF" ]; then
    if git ls-remote --exit-code --tags "$CAELESTIA_REPO_URL" "$TARGET_REF" >/dev/null 2>&1; then
        TARGET_KIND="tag"
    elif [ "$BRANCH" = "dev" ] && [[ "$TARGET_REF" =~ ^[0-9a-f]{7,40}$ ]]; then
        # Dev branch supports installing/reverting to a specific commit from the
        # timeline, not just tagged releases.
        TARGET_KIND="commit"
    else
        echo "Warning: Version tag '$TARGET_REF' not found on remote. Ignoring target and using branch head."
        TARGET_REF=""
    fi
fi
UPD_DIR="$HOME/.config/caelestia-update"

# Prevent concurrent update runs in a private directory.
LOCK_DIR="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/caelestia"
mkdir -p "$LOCK_DIR"
chmod 700 "$LOCK_DIR"
exec 9>"$LOCK_DIR/update.lock"
flock -n 9 || { echo "Another Caelestia update is already running."; exit 1; }

echo "---------------------------------------------"
if [ -n "$TARGET_REF" ]; then
    echo "  Caelestia Update (Branch: $BRANCH, Target: $TARGET_REF)"
else
    echo "  Caelestia Update (Branch: $BRANCH)"
fi
echo "---------------------------------------------"

# --- Pre-flight Dependency Checks ---
for cmd in git cmake make; do
    if ! command -v "$cmd" &> /dev/null; then
        die "Required command '$cmd' is missing. Please install it first."
    fi
done

# --- Robust Privilege Escalation Wrapper ---
# The wrapper tries cached credentials first (sudo -n), and only falls
# back to an interactive prompt when the timestamp is truly expired.
mkdir -p "$UPD_DIR/bin"
cat << 'EOF' > "$UPD_DIR/bin/sudo"
#!/usr/bin/env bash
if [ "$EUID" -eq 0 ]; then
    exec "$@"
fi
# Try non-interactive first — if the parent keepalive has kept the
# timestamp fresh this succeeds without any prompt at all.
if /usr/bin/sudo -n true 2>/dev/null; then
    exec /usr/bin/sudo -n "$@"
fi
# Timestamp expired or never created: fall back to whatever interactive
# helper is available (terminal, ksshaskpass, pkexec).
if [ -t 1 ]; then
    exec /usr/bin/sudo "$@"
elif command -v ksshaskpass &> /dev/null; then
    exec env SUDO_ASKPASS="$(command -v ksshaskpass)" /usr/bin/sudo -A "$@"
elif command -v pkexec &> /dev/null; then
    exec pkexec "$@"
else
    echo "Cannot elevate privileges. Please install ksshaskpass, pkexec, or run from a terminal." >&2
    exit 1
fi
EOF
chmod +x "$UPD_DIR/bin/sudo"
export PATH="$UPD_DIR/bin:$PATH"

# --- Prime privilege escalation once, then keep it alive ---
# Several steps below need root (system package update, the shell install
# step). Authenticate once up front and refresh the cached credential in
# the background so later sudo calls (which can happen well after the
# initial prompt, e.g. after a long shell build) reuse it instead of
# prompting again.
if [ "$EUID" -ne 0 ]; then
    # Determine the best interactive helper for the initial prompt.
    if [ -t 1 ]; then
        SUDO_ASK_CMD=(/usr/bin/sudo -v)
    elif command -v ksshaskpass &> /dev/null; then
        SUDO_ASK_CMD=(env SUDO_ASKPASS="$(command -v ksshaskpass)" /usr/bin/sudo -A -v)
    elif command -v pkexec &> /dev/null; then
        # pkexec authenticates via PolicyKit, not sudo's timestamp cache.
        # There is no way to "prime" sudo from pkexec — each subsequent
        # elevation will go through pkexec individually. PolicyKit has
        # its own short-lived authorization caching, so the user won't
        # be prompted for every single command.
        info "Requesting administrator privileges via pkexec (PolicyKit)…"
        # Root is optional for the update itself (the only root-requiring
        # step, the workspace-tracker effect install, warns and continues),
        # so a failed priming must not abort the whole update — e.g. when
        # pkexec is unavailable headless or rejects the environment's SHELL.
        pkexec true || warn "Could not prime administrator privileges; continuing without root (system-level steps will be skipped)."
        # Skip the sudo keepalive — it's useless without a sudo timestamp.
        # The sudo wrapper ($UPD_DIR/bin/sudo) will use pkexec for each
        # elevation via its fallback path.
        SUDO_ASK_CMD=()  # signal: skip sudo -v below
    else
        warn "No privilege helper available (terminal, ksshaskpass, pkexec); continuing without root — system-level steps will be skipped."
    fi

    if [[ ${#SUDO_ASK_CMD[@]} -gt 0 ]]; then
        info "Requesting administrator privileges (used for system update and installing the shell)..."
        "${SUDO_ASK_CMD[@]}" || warn "Could not prime administrator privileges; continuing without root (system-level steps will be skipped)."
    fi

    # Export SUDO_ASKPASS so any sub-scripts that use raw /usr/bin/sudo -A
    # (or the wrapper above) can resolve the askpass helper without needing
    # to re-discover it in a non-tty child.
    if command -v ksshaskpass &> /dev/null; then
        SUDO_ASKPASS="$(command -v ksshaskpass)"
        export SUDO_ASKPASS
    fi

    # Background keepalive: refresh the sudo timestamp every 30 seconds
    # so it never expires, even during long operations like CMake builds.
    # Using -nv instead of -n true ensures the timestamp is *extended*,
    # not just checked.
    # Only started when we actually have a sudo timestamp to keep alive
    # (tty or ksshaskpass paths above).  The pkexec path skips this
    # because PolicyKit handles its own authorization caching.
    if [[ ${#SUDO_ASK_CMD[@]} -gt 0 ]]; then
        (
            while kill -0 "$$" 2>/dev/null; do
                sleep 30
                sudo -nv 2>/dev/null || true
            done
        ) &
        SUDO_KEEPALIVE_PID=$!
        trap '[ -n "${SUDO_KEEPALIVE_PID:-}" ] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT
    fi
fi

# 1. Fetch from GitHub
echo "PROGRESS: 1/5: Fetching updates from GitHub..."
info "Checking for local repository cache..."

# --- Safe Backup Directory outside of the git repo ---
BACKUP_DIR="$UPD_DIR/backups/$(date +%Y%m%d_%H%M%S)"
export BACKUP_DIR
mkdir -p "$BACKUP_DIR"

if [[ ! -d "$UPD_DIR/repo/.git" ]]; then
    mkdir -p "$UPD_DIR/repo"
    cd "$UPD_DIR/repo" || die "Could not enter $UPD_DIR/repo"
    git init -q
    git remote add origin "$CAELESTIA_REPO_URL"
else
    cd "$UPD_DIR/repo" || die "Could not enter $UPD_DIR/repo"
    git reset --hard -q HEAD || die "Failed to reset repository state"
    git clean -fdx -q
    git remote set-url origin "$CAELESTIA_REPO_URL"
fi

# Always enforce sparse-checkout rules
git config core.sparseCheckout true
echo "shell/" > .git/info/sparse-checkout
echo "src/" >> .git/info/sparse-checkout
echo "scripts/" >> .git/info/sparse-checkout
echo ".github/version.env" >> .git/info/sparse-checkout
echo ".gitmodules" >> .git/info/sparse-checkout

# Safer fetch and reset instead of pull
if [ -n "$TARGET_REF" ] && [ "${TARGET_KIND:-}" = "commit" ]; then
    # Arbitrary commit target: the local clone is normally shallow (depth 1), so
    # pull enough history to cover the commit timeline shown in the UI
    # (UpdateChecker fetches up to 150 commits) rather than trying to unshallow.
    git fetch -q --depth=200 origin "$BRANCH" || die "Failed to fetch repository"
    if git cat-file -e "$TARGET_REF^{commit}" 2>/dev/null; then
        git reset --hard -q "$TARGET_REF" || die "Failed to apply commit $TARGET_REF"
    else
        warn "Commit '$TARGET_REF' not found on '$BRANCH'; falling back to branch head."
        git reset --hard -q origin/"$BRANCH" || die "Failed to apply updates"
    fi
elif [ -n "$TARGET_REF" ]; then
    git fetch -q --depth 1 origin "refs/tags/$TARGET_REF:refs/tags/$TARGET_REF" || die "Failed to fetch version tag"
    git reset --hard -q "$TARGET_REF" || die "Failed to apply version $TARGET_REF"
elif [ "$BRANCH" = "main" ]; then
    # Stable updates follow the newest release tag, never a mutable branch head.
    git fetch -q --depth=1 --tags origin || die "Failed to fetch release tags"
    TARGET_REF="$(git tag --list 'v[0-9]*' --sort=-version:refname | head -n1)"
    [ -n "$TARGET_REF" ] || die "No stable release tag is available"
    TARGET_KIND="tag"
    git reset --hard -q "$TARGET_REF" || die "Failed to apply release $TARGET_REF"
else
    git fetch -q --depth 1 origin "$BRANCH" || die "Failed to fetch repository"
    git reset --hard -q origin/"$BRANCH" || die "Failed to apply updates"
fi

# Verify the superproject BEFORE touching submodules.
#
# Submodule init reads .gitmodules from the checkout and fetches from three
# third-party hosts. Doing that before the signature check meant acting on an
# unverified .gitmodules -- writing content from URLs an unverified commit
# chose. Nothing was executed, but the verification gap was real, and update.sh
# already gets this order right.
verify_checkout

# Initialize submodules
if [[ -f "$UPD_DIR/repo/.gitmodules" ]]; then
    info "Initializing all submodule..."
    git submodule sync --recursive >/dev/null 2>&1 || true
    git submodule update --init --recursive --force >/dev/null 2>&1 || die "Failed to initialize all submodules"
fi

[[ -f "$UPD_DIR/repo/src/dots/starship.toml" ]] || die "Missing src/dots content after update"

# 2. System update via Polkit
echo "PROGRESS: 2/5: Running system update..."
echo
echo "---------------------------------------------"
echo "  Step 1 - System Updates"
echo "---------------------------------------------"
if command -v pacman >/dev/null; then
    info "Running system update via pacman..."
    sudo pacman -Syu --noconfirm || warn "System update was canceled or failed. Continuing with non-sudo parts..."
elif command -v dnf >/dev/null; then
    info "Running system update via dnf..."
    sudo dnf upgrade --refresh -y || warn "System update was canceled or failed. Continuing with non-sudo parts..."
elif command -v apt-get >/dev/null; then
    info "Running system update via apt..."
    sudo apt-get update && sudo apt-get upgrade -y || warn "System update was canceled or failed. Continuing with non-sudo parts..."
fi

# 3. Build script now handles GUI privilege escalation natively.
info "Executing build scripts (GUI prompts will appear if required)..."

export BUNDLE_DIR="$UPD_DIR/repo"

# 4. Deploy Configs
echo "PROGRESS: 3/5: Deploying configuration files..."
echo
echo "---------------------------------------------"
echo "  Step 2 - Deploy Configs"
echo "---------------------------------------------"
if [[ "${CAELESTIA_SKIP_DEPLOY:-0}" == "1" ]]; then
    info "Skipping deploy-configs per user settings."
else
    run_stage 900 bash "$UPD_DIR/repo/scripts/03-deploy-configs.sh" || die "Config deployment failed or timed out."
fi
echo "PROGRESS: 3/5: Configuration files deployed."

# 5. Build Shell
echo "PROGRESS: 4/5: Building Caelestia Shell UI..."
echo
echo "---------------------------------------------"
echo "  Step 3 - Build Caelestia Shell UI"
echo "---------------------------------------------"
if [[ "${CAELESTIA_SKIP_BUILD:-0}" == "1" ]]; then
    info "Skipping build-shell per user settings."
else
    run_stage 3600 bash "$UPD_DIR/repo/scripts/08-build-shell.sh" || die "Shell build failed or timed out."

    # Fail fast if QML module install is incomplete, otherwise shell startup fails
    # with 'module "Caelestia.Config" is not installed'.
    QML_BASE="$HOME/.local/lib/qt6/qml"
    CONFIG_MODULE_DIR="$QML_BASE/Caelestia/Config"
    if [[ ! -f "$CONFIG_MODULE_DIR/qmldir" ]]; then
        die "Installed QML module metadata missing at $CONFIG_MODULE_DIR/qmldir"
    fi

    shopt -s nullglob
    CONFIG_PLUGIN_FILES=("$CONFIG_MODULE_DIR"/*.so)
    shopt -u nullglob
    if [[ ${#CONFIG_PLUGIN_FILES[@]} -eq 0 ]]; then
        die "Installed Caelestia.Config plugin library missing in $CONFIG_MODULE_DIR"
    fi
fi

# 6. Save current commit hash
if [ -d "$UPD_DIR/repo/.git" ]; then
    COMMIT_HASH=$(git rev-parse HEAD)
    mkdir -p ~/.config/quickshell/caelestia
    echo "$COMMIT_HASH" > ~/.config/quickshell/caelestia/.current_commit

    # Persist installed version from the checked-out commit, even when sparse checkout omits files.
    git show HEAD:.github/version.env > ~/.config/quickshell/caelestia/.current_version 2>/dev/null || true

    info "Saved commit hash: $COMMIT_HASH"
fi

echo "PROGRESS: done: Update completed successfully"
echo
echo "---------------------------------------------"
echo "  Update Completed Successfully!"
echo "---------------------------------------------"
